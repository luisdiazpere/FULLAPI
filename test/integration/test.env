# Env for `npm run test:integration` only. No real secrets: STRIPE_SECRET_KEY
# still comes from your own .env (a real read-only call against Stripe's test
# API is part of what this suite verifies). Everything here just needs to be
# *some* non-empty value to satisfy src/env.ts, or (the webhook secrets) needs
# to match what the test signs with — see scripts/test-integration.sh.
DATABASE_URL=postgres://bandera:bandera@localhost:5433/scratchtest
COUNTRIES_API_URL=https://example.invalid/v5
COUNTRIES_API_KEY=integration-test-placeholder
CHECKOUT_SUCCESS_URL=https://example.invalid/success
CHECKOUT_CANCEL_URL=https://example.invalid/cancel
STRIPE_WEBHOOK_SECRET=whsec_integration_test_only_not_a_real_secret
SHIPPO_WEBHOOK_TOKEN=integration-test-token
