{
  "info": {
    "name": "Bandera y Sello — MCP over HTTP",
    "description": "Drives the shop's MCP server (Streamable HTTP, stateless) at POST /mcp.\n\nStart both processes first:\n  npm start        # the shop on :3000\n  npm run mcp:http # the MCP server on :3001\n\nThe server is stateless, so every request stands alone — there is no session id to carry and `initialize` is not a prerequisite for `tools/call`. It is included first because a real MCP client always sends it.\n\nResponses are plain JSON (the server sets enableJsonResponse), not SSE frames.\n\nWARNING: the 'Payment' folder spends real stock. See its description.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "mcpUrl",
      "value": "http://localhost:3001/mcp"
    },
    {
      "key": "shopOrigin",
      "value": "http://localhost:3000"
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 · Handshake",
      "item": [
        {
          "name": "initialize",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"is a JSON-RPC result, not an error\", () => {",
                  "    pm.expect(body).to.have.property(\"jsonrpc\", \"2.0\");",
                  "    pm.expect(body, JSON.stringify(body.error)).to.not.have.property(\"error\");",
                  "});",
                  "const payload = body.result?.content?.[0]?.text;",
                  "if (payload !== undefined) {",
                  "    pm.test(\"tool did not report a failure\", () => {",
                  "        pm.expect(body.result.isError, payload).to.not.eql(true);",
                  "    });",
                  "    try { console.log(JSON.parse(payload)); } catch { console.log(payload); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2025-06-18\",\n    \"capabilities\": {},\n    \"clientInfo\": {\n      \"name\": \"postman\",\n      \"version\": \"1.0\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{mcpUrl}}",
              "host": [
                "{{mcpUrl}}"
              ]
            }
          }
        },
        {
          "name": "tools/list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"is a JSON-RPC result, not an error\", () => {",
                  "    pm.expect(body).to.have.property(\"jsonrpc\", \"2.0\");",
                  "    pm.expect(body, JSON.stringify(body.error)).to.not.have.property(\"error\");",
                  "});",
                  "const payload = body.result?.content?.[0]?.text;",
                  "if (payload !== undefined) {",
                  "    pm.test(\"tool did not report a failure\", () => {",
                  "        pm.expect(body.result.isError, payload).to.not.eql(true);",
                  "    });",
                  "    try { console.log(JSON.parse(payload)); } catch { console.log(payload); }",
                  "}",
                  "",
                  "pm.test(\"all nine tools are advertised\", () => {",
                  "    pm.expect(body.result.tools).to.have.lengthOf(9);",
                  "});",
                  "pm.test(\"create_payment_link is the only tool that writes\", () => {",
                  "    const writes = body.result.tools.filter(t => t.annotations?.readOnlyHint !== true);",
                  "    pm.expect(writes.map(t => t.name)).to.eql([\"create_payment_link\"]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/list\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{mcpUrl}}",
              "host": [
                "{{mcpUrl}}"
              ]
            }
          }
