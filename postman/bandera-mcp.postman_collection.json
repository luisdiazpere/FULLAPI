        {
          "name": "check_shipping — Japan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const text = body.result.content[0].text;",
                  "// Passes either way: with SHIPPO_API_KEY set this checks the quote, and without",
                  "// one it checks that the tool says so cleanly instead of inventing a price.",
                  "if (body.result.isError) {",
                  "    pm.test(\"no carrier key configured, and the tool says so plainly\", () => {",
                  "        pm.expect(text).to.include(\"not configured\");",
                  "    });",
                  "} else {",
                  "    const quote = JSON.parse(text);",
                  "    pm.test(\"quotes a serviceable destination in minor units\", () => {",
                  "        pm.expect(quote).to.have.property(\"serviceable\");",
                  "        if (quote.serviceable) {",
                  "            pm.expect(quote.methods).to.be.an(\"array\").that.is.not.empty;",
                  "            quote.methods.forEach(m => pm.expect(m.amount).to.be.a(\"number\"));",
                  "        }",
                  "    });",
                  "    pm.test(\"parcel weight is the summed order, not one kit\", () => {",
                  "        pm.expect(quote.parcel.weightGrams).to.eql(600 * 2 + 300);",
                  "    });",
                  "}",
                  "console.log(text);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"check_shipping\",\n    \"arguments\": {\n      \"countryCode\": \"JPN\",\n      \"items\": [\n        {\n          \"kitSku\": \"flag-and-seal\",\n          \"countryCode\": \"JPN\",\n          \"quantity\": 2\n        },\n        {\n          \"kitSku\": \"capital-postcards\",\n          \"countryCode\": \"FRA\",\n          \"quantity\": 1\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{mcpUrl}}",
              "host": [
                "{{mcpUrl}}"
              ]
            },
            "description": "Needs SHIPPO_API_KEY. Without it the shop answers 503 and this tool reports that shipping cannot be quoted — which is a correct answer, so it is not an isError."
