PORT=3000
DATABASE_URL=postgres://bandera:bandera@localhost:5433/bandera
STRIPE_SECRET_KEY=sk_test_replace_me
COUNTRIES_API_URL=https://api.restcountries.com/countries/v5
COUNTRIES_API_KEY=replace_me
CHECKOUT_SUCCESS_URL=http://localhost:3000/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:3000/cancel

# Shipping quotes (optional). Without SHIPPO_API_KEY the shop still runs and the
# shipping endpoints answer 503 shipping_unconfigured. Shippo test keys quote
# without any carrier account.
SHIPPO_API_KEY=
SHIP_FROM_COUNTRY=US
SHIP_FROM_ZIP=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_STREET=

# The MCP server. SHOP_BASE_URL is the only variable the stdio server needs.
SHOP_BASE_URL=http://localhost:3000
MCP_HTTP_PORT=3001
MCP_ALLOWED_ORIGINS=http://localhost:3000

# Stripe webhook (payment confirmation + triggers the shipping label purchase).
# Without it, POST /api/webhooks/stripe answers 503 webhook_unconfigured.
# Get this from `stripe listen` locally, or the Dashboard's webhook endpoint page.
STRIPE_WEBHOOK_SECRET=

# Brevo transactional email, sent over real SMTP. Without these, emails are
# skipped (logged, not sent) rather than failing the webhook.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
EMAIL_FROM="Bandera y Sello <no-reply@example.com>"

# Shippo does not sign its webhook payloads, so this shared secret is appended
# as ?token=... on the URL registered with Shippo for the track_updated event.
# Without it, POST /api/webhooks/shippo answers 503 webhook_unconfigured.
SHIPPO_WEBHOOK_TOKEN=

# Powers the shop-page chat (POST /api/chat), wired to the shop's own MCP tools
# in-process. Without it, the endpoint answers 503 chat_unconfigured.
DEEPSEEK_API_KEY=
