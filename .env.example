PORT=3000
DATABASE_URL=postgres://bandera:bandera@localhost:5433/bandera
STRIPE_SECRET_KEY=sk_test_replace_me
COUNTRIES_API_URL=https://api.restcountries.com/countries/v5
COUNTRIES_API_KEY=replace_me
CHECKOUT_SUCCESS_URL=http://localhost:3000/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:3000/cancel

# Shipping quotes (optional). Without SHIPPO_API_KEY the shop still runs and the
# shipping endpoints answer 503 shipping_unconfigured. Shippo test keys quote
# without any carrier account.
SHIPPO_API_KEY=
SHIP_FROM_COUNTRY=US
SHIP_FROM_ZIP=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_STREET=

# The MCP server. SHOP_BASE_URL is the only variable the stdio server needs.
SHOP_BASE_URL=http://localhost:3000
MCP_HTTP_PORT=3001
MCP_ALLOWED_ORIGINS=http://localhost:3000
