PORT=3000
DATABASE_URL=postgres://bandera:bandera@localhost:5433/bandera
STRIPE_SECRET_KEY=sk_test_replace_me
COUNTRIES_API_URL=https://api.restcountries.com/countries/v5
COUNTRIES_API_KEY=replace_me
CHECKOUT_SUCCESS_URL=http://localhost:3000/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:3000/cancel

# Shipping quotes (optional). Without SHIPPO_API_KEY the shop still runs and the
# shipping endpoints answer 503 shipping_unconfigured. Shippo test keys quote
# without any carrier account.
SHIPPO_API_KEY=
SHIP_FROM_COUNTRY=US
SHIP_FROM_ZIP=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_STREET=


# The public origin of the shop. Used for the "Browse the shop" link in the welcome
# email, and as the default allow-list entry for the frontend-only API perimeter
# (src/perimeter.ts) when ALLOWED_ORIGINS is unset.
SHOP_BASE_URL=http://localhost:3000

# Origins allowed to call /api/*, comma separated. Defaults to the origin of
# CHECKOUT_SUCCESS_URL, which is right for a single-domain deployment.
ALLOWED_ORIGINS=

# Stripe webhook (payment confirmation + triggers the shipping label purchase).
# Without it, POST /api/webhooks/stripe answers 503 webhook_unconfigured.
# Get this from `stripe listen` locally, or the Dashboard's webhook endpoint page.
STRIPE_WEBHOOK_SECRET=

# Brevo transactional email, sent over real SMTP. Without these, emails are
# skipped (logged, not sent) rather than failing the webhook.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
EMAIL_FROM="Bandera y Sello <no-reply@example.com>"

# Shippo does not sign its webhook payloads, so this shared secret is appended
# as ?token=... on the URL registered with Shippo for the track_updated event.
# Without it, POST /api/webhooks/shippo answers 503 webhook_unconfigured.
SHIPPO_WEBHOOK_TOKEN=

# Powers the shop-page chat (POST /api/chat), wired to the shop's own MCP tools
# in-process. Without it, the endpoint answers 503 chat_unconfigured.
DEEPSEEK_API_KEY=

# Clerk backend secret key — the login UI here is fully custom, this key is only
# used server-side (src/clerkAuth.ts) to create/verify accounts via Clerk's
# Backend API. Get it from the Clerk dashboard's API Keys page (starts with
# sk_test_ or sk_live_). Without it, /api/auth/signup and /api/auth/login
# answer 503 auth_unconfigured.
CLERK_SECRET_KEY=

# Clerk publishable key — safe to expose client-side, it's templated straight into
# public/index.html to load Clerk's frontend SDK for the "Continue with Google" button
# (the button itself stays ours; only the OAuth redirect is Clerk's). Same dashboard
# page as CLERK_SECRET_KEY (starts with pk_test_ or pk_live_). Google also has to be
# turned on as a social connection there — Settings > User & Authentication > Social
# Connections — that step can't be done from code. Without this key the button renders
# but does nothing (the SDK never loads).
CLERK_PUBLISHABLE_KEY=

# Clerk webhook (welcome email on user.created). Get this from the Clerk
# dashboard's Webhooks page when you create the endpoint (starts with
# whsec_). Without it, POST /api/webhooks/clerk answers 503 webhook_unconfigured.
CLERK_WEBHOOK_SIGNING_SECRET=
